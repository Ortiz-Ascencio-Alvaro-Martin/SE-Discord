\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Los 7 slash commands registrados en Discord: \texttt  {/ajustar\_precio}, \texttt  {/borrar\_negocio}, \texttt  {/ciclo\_avanzar}, \texttt  {/crear\_negocio}, \texttt  {/dashboard}, \texttt  {/marketing}, \texttt  {/proveedor}.}}{8}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \texttt  {/crear\_negocio} — cafeter\'ia creada en Providencia con multiplicador de renta $\times 1.5$ y demanda $\times 1.2$. Caja inicial \$100,000 MXN.}}{8}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \texttt  {/dashboard} — inventario desglosado por insumo, indicadores econ\'omicos (margen de contribuci\'on, punto de equilibrio, costo variable) y color condicional.}}{9}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \texttt  {/ciclo\_avanzar} — evento global ``Helada en Brasil'' eleva el costo del grano 25\,\%. Se muestran tazas vendidas, ingresos, flujo neto, caja final y el n\'umero de reglas disparadas. Botones: Avanzar ciclo, Ver explicaci\'on, Pagar N\'omina.}}{10}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Reporte del Agente 3 (Supervisor) — explica en lenguaje natural las decisiones tomadas por el motor de inferencias, incluyendo el cambio de precio y su justificaci\'on.}}{10}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \texttt  {/proveedor} — compra de Leche entera: se descuentan \$120 MXN de caja y se suman 30 tazas al inventario. El dashboard refleja el cambio en tiempo real.}}{11}{figure.6}\protected@file@percent }
